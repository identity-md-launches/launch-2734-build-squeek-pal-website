{
  "name": "squeek-pal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Squeek Pal: a pixel hamster companion for x.com, synced to Squeektoshi's wheel. Website + browser extension.",
  "scripts": {
    "build:ext": "node scripts/build-extension.mjs",
    "build:site": "vite build",
    "build": "npm run build:ext && npm run build:site",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
